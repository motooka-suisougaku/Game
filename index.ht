<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>JS SURVIVOR - ULTIMATE EDITION</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #050510; font-family: sans-serif; touch-action: none; color: white; user-select: none; }
        canvas { display: block; }
        .overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; background: rgba(0,0,0,0.85); z-index: 20; }
        .hidden { display: none !important; }
        h1 { font-size: 40px; color: #ffcc00; margin-bottom: 10px; text-shadow: 0 0 20px #ffcc00; text-align: center;}
        h2 { color: #00ffcc; }
        button, select, input { font-size: 18px; padding: 12px 24px; margin: 8px; border-radius: 8px; background: #1a1a2e; color: white; border: 2px solid #444; cursor: pointer; text-align: center; }
        button:hover { border-color: #00ffcc; background: #2a2a4e; }
        button:disabled { border-color: #333; color: #555; cursor: not-allowed; }
        
        #ui-layer { position: absolute; top: 0; left: 0; width: 100%; padding: 10px; box-sizing: border-box; pointer-events: none; z-index: 10; }
        .stats { display: flex; justify-content: space-between; font-size: 18px; font-weight: bold; text-shadow: 2px 2px 0 #000; }
        #exp-bg { width: 100%; height: 8px; background: #222; border-radius: 4px; margin-top: 8px; border: 1px solid #333; }
        #exp-bar { width: 0%; height: 100%; background: #00ffcc; transition: width 0.1s; }
        
        .skill-card { background: #222; border: 2px solid #444; border-radius: 10px; padding: 15px; margin: 5px; width: 280px; text-align: center; cursor: pointer; }
        .skill-card:hover { border-color: #00ffcc; background: #333; }
        
        /* ガチャ・キャラ画面用 */
        #gacha-result { font-size: 32px; font-weight: bold; color: #ff00ff; text-shadow: 0 0 10px #ff00ff; margin: 20px 0; display: none; }
        .char-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; max-height: 50vh; overflow-y: auto; padding: 10px; }
        .char-box { border: 2px solid #555; border-radius: 8px; padding: 10px; text-align: center; cursor: pointer; background: #111; }
        .char-box.owned { border-color: #00ffcc; }
        .char-box.selected { background: #00ffcc; color: black; font-weight: bold; }
        
        #boss-notice { position: absolute; top: 20%; width: 100%; text-align: center; font-size: 50px; color: red; font-weight: bold; text-shadow: 2px 2px 0 #000; display: none; z-index: 30; }
    </style>
</head>
<body>

    <div id="screen-login" class="overlay">
        <h1>JS SURVIVOR</h1>
        <p>プレイヤー名を入力してください</p>
        <input type="text" id="player-name-input" placeholder="名前 (最大10文字)" maxlength="10">
        <button id="btn-login">ゲーム開始</button>
    </div>

    <div id="screen-home" class="overlay hidden">
        <h1>HOME</h1>
        <p>ようこそ、<span id="disp-name" style="color:#00ffcc;"></span> さん!</p>
        <p>所持コイン: <span id="disp-coins" style="color:#ffcc00; font-size:24px;">0</span> C</p>
        <div>
            <select id="stage-select"></select>
            <button id="btn-start">通常出撃</button>
            <button id="btn-raid-menu" style="border-color:#ff00ff; color:#ffccff;">レイドバトル (覚醒)</button>
        </div>
        <div style="margin-top: 15px;">
            <button id="btn-gacha-menu">ガチャを引く (1000C)</button>
            <button id="btn-char-menu">キャラ変更</button>
        </div>
    </div>

    <div id="screen-chars" class="overlay hidden">
        <h2>キャラクター選択</h2>
        <div id="char-list" class="char-grid"></div>
        <button id="btn-close-chars">ホームに戻る</button>
    </div>

    <div id="screen-raid" class="overlay hidden">
        <h2 style="color:#ff00ff;">挑む覚醒ボスを選択</h2>
        <p>勝利するとそのキャラが覚醒し、永続強化されます！</p>
        <div id="raid-char-list" class="char-grid"></div>
        <button id="btn-close-raid">ホームに戻る</button>
    </div>

    <div id="screen-gacha" class="overlay hidden">
        <h1 style="color:#ff00ff;">CHARACTER GACHA</h1>
        <p>1回 1000 コイン</p>
        <button id="btn-pull-gacha">ガチャを引く!</button>
        <div id="gacha-result"></div>
        <button id="btn-close-gacha">ホームに戻る</button>
    </div>

    <div id="screen-levelup" class="overlay hidden">
        <h2>LEVEL UP!</h2>
        <div id="skill-container"></div>
    </div>

    <div id="screen-result" class="overlay hidden">
        <h1 id="res-title">FINISH</h1>
        <p style="font-size: 24px;">獲得コイン: <span id="res-coins" style="color:#ffcc00;">0</span> C</p>
        <button id="btn-restart">HOME</button>
    </div>

    <div id="ui-layer" class="hidden">
        <div class="stats">
            <div>Lv.<span id="ui-level">1</span></div>
            <div id="timer" style="color:#ff4444">05:00</div>
            <div id="ui-char-name" style="color:#00ffcc;"></div>
        </div>
        <div id="exp-bg"><div id="exp-bar"></div></div>
    </div>

    <div id="boss-notice">WARNING: HUGE BOSS!!</div>
    <canvas id="gameCanvas"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        let width, height;
        function resize() {
            width = window.innerWidth; height = window.innerHeight;
            canvas.width = width; canvas.height = height;
        }
        window.addEventListener('resize', resize);
        resize();

        // --- データ管理 ---
        let saveData = { name: "", coins: 0, unlockedStage: 1, chars: [0], selectedChar: 0, awakenedChars: [] };
        
        // 20体のキャラクター定義
        const CHAR_DATA = [
            { id: 0, name: "ルーキー", color: "#09f", hp: 100, spd: 4.0, atk: 15, multi: 1, orb: 0, mag: 120, desc: "標準的な能力" },
            { id: 1, name: "ニンジャ", color: "#333", hp: 60, spd: 5.5, atk: 10, multi: 1, orb: 0, mag: 100, desc: "超高速・低耐久" },
            { id: 2, name: "タンク", color: "#8b4513", hp: 250, spd: 2.5, atk: 20, multi: 1, orb: 0, mag: 150, desc: "鈍足・超高耐久" },
            { id: 3, name: "スナイパ", color: "#0f0", hp: 80, spd: 3.5, atk: 40, multi: 1, orb: 0, mag: 80, desc: "高火力の一撃" },
            { id: 4, name: "マグネ", color: "#f0f", hp: 100, spd: 3.8, atk: 12, multi: 1, orb: 0, mag: 300, desc: "経験値を広範囲回収" },
            { id: 5, name: "パラディン", color: "#ffd700", hp: 150, spd: 3.0, atk: 15, multi: 1, orb: 1, mag: 120, desc: "初期バリア持ち" },
            { id: 6, name: "ガンナー", color: "#ff4500", hp: 90, spd: 4.0, atk: 8, multi: 3, orb: 0, mag: 100, desc: "初期から3方向射撃" },
            { id: 7, name: "ヴァンピィ", color: "#800080", hp: 100, spd: 4.2, atk: 15, multi: 1, orb: 0, mag: 120, desc: "敵を倒すと微回復" },
            { id: 8, name: "サイボーグ", color: "#708090", hp: 180, spd: 3.2, atk: 25, multi: 1, orb: 0, mag: 100, desc: "高い攻防力" },
            { id: 9, name: "エスパー", color: "#00ffff", hp: 70, spd: 4.5, atk: 10, multi: 1, orb: 3, mag: 150, desc: "初期バリア3個" },
            { id: 10, name: "バーサーカ", color: "#b22222", hp: 120, spd: 4.5, atk: 35, multi: 1, orb: 0, mag: 90, desc: "高火力・高速" },
            { id: 11, name: "ゴースト", color: "#e6e6fa", hp: 50, spd: 5.0, atk: 12, multi: 1, orb: 0, mag: 200, desc: "低HPだが回収と足が速い" },
            { id: 12, name: "サムライ", color: "#cd5c5c", hp: 110, spd: 4.2, atk: 28, multi: 1, orb: 0, mag: 110, desc: "バランスの良い高火力" },
            { id: 13, name: "リッチ", color: "#483d8b", hp: 80, spd: 3.8, atk: 20, multi: 2, orb: 1, mag: 130, desc: "魔法使い。多機能" },
            { id: 14, name: "ギャンブラ", color: "#ff1493", hp: 100, spd: 4.0, atk: 5, multi: 1, orb: 0, mag: 150, desc: "コイン獲得量2倍" },
            { id: 15, name: "ドクター", color: "#ffffff", hp: 120, spd: 3.5, atk: 10, multi: 1, orb: 0, mag: 100, desc: "レベルアップ時全回復" },
            { id: 16, name: "アーチャー", color: "#228b22", hp: 90, spd: 4.3, atk: 22, multi: 2, orb: 0, mag: 110, desc: "2方向・高威力" },
            { id: 17, name: "エイリアン", color: "#7fff00", hp: 100, spd: 4.8, atk: 18, multi: 1, orb: 0, mag: 80, desc: "謎の宇宙人" },
            { id: 18, name: "ドラゴン", color: "#dc143c", hp: 200, spd: 3.8, atk: 30, multi: 1, orb: 1, mag: 100, desc: "圧倒的なステータス" },
            { id: 19, name: "カミサマ", color: "#ffea00", hp: 999, spd: 6.0, atk: 99, multi: 5, orb: 5, mag: 500, desc: "チート級(超絶レア)" }
        ];

        function loadData() {
            let d = localStorage.getItem('jsSurvivorSave');
            if(d) {
                saveData = JSON.parse(d);
                if(!saveData.awakenedChars) saveData.awakenedChars = [];
            }
            if(saveData.name) {
                document.getElementById('screen-login').classList.add('hidden');
                openHome();
            }
        }
        function saveGame() { localStorage.setItem('jsSurvivorSave', JSON.stringify(saveData)); }

        // --- ゲーム内変数 ---
        let state = 'LOGIN', playTime = 300, scoreCoins = 0, frameCount = 0;
        let isBossActive = false, bossDefeated = false, currentStage = 1;
        let player, enemies, bullets, gems, orbits, damageTexts, hazards;
        let targetPos = { x: 0, y: 0 };
        
        let isRaidMode = false;
        let raidTargetCharId = 0;

        const skillPool = [
            { id: 'multi', name: '連射', desc: '弾数+1' },
            { id: 'power', name: '威力', desc: 'ダメージ+10' },
            { id: 'orbit', name: 'バリア', desc: '周囲を回る守護石' },
            { id: 'magnet', name: '磁石', desc: '回収範囲UP' },
            { id: 'speed', name: '加速', desc: '移動速度UP' },
            { id: 'heal', name: '回復', desc: 'HPを50%回復' }
        ];

        // --- UI操作 ---
        document.getElementById('btn-login').onclick = () => {
            let n = document.getElementById('player-name-input').value.trim();
            if(!n) return alert("名前を入力してください!");
            saveData.name = n; saveGame();
            document.getElementById('screen-login').classList.add('hidden');
            openHome();
        };

        function openHome() {
            state = 'HOME';
            document.getElementById('disp-name').innerText = saveData.name;
            document.getElementById('disp-coins').innerText = saveData.coins;
            
            const select = document.getElementById('stage-select');
            select.innerHTML = "";
            for(let i=1; i<=30; i++) {
                let opt = document.createElement('option');
                opt.value = i; opt.innerText = `STAGE ${i}`;
                if(i > saveData.unlockedStage) opt.disabled = true;
                select.appendChild(opt);
            }
            select.value = Math.min(saveData.unlockedStage, 30);
            
            document.querySelectorAll('.overlay').forEach(e => e.classList.add('hidden'));
            document.getElementById('screen-home').classList.remove('hidden');
        }

        // キャラクター画面
        document.getElementById('btn-char-menu').onclick = () => {
            document.getElementById('screen-home').classList.add('hidden');
            const list = document.getElementById('char-list');
            list.innerHTML = "";
            CHAR_DATA.forEach(c => {
                let isOwned = saveData.chars.includes(c.id);
                let isAwakened = saveData.awakenedChars.includes(c.id);
                let div = document.createElement('div');
                div.className = `char-box ${isOwned ? 'owned' : ''} ${saveData.selectedChar === c.id ? 'selected' : ''}`;
                
                let nameHtml = isOwned ? c.name : '???';
                if (isAwakened) nameHtml += ' <span style="color:#f0f; font-size:14px;">★覚醒</span>';
                
                div.innerHTML = `<strong>${nameHtml}</strong><br><span style="font-size:14px;">${isOwned ? c.desc : '未解放'}</span>`;
                if(isOwned) {
                    div.onclick = () => { saveData.selectedChar = c.id; saveGame(); document.getElementById('btn-char-menu').click(); };
                }
                list.appendChild(div);
            });
            document.getElementById('screen-chars').classList.remove('hidden');
        };
        document.getElementById('btn-close-chars').onclick = openHome;

        // レイドバトル画面
        document.getElementById('btn-raid-menu').onclick = () => {
            document.getElementById('screen-home').classList.add('hidden');
            const list = document.getElementById('raid-char-list');
            list.innerHTML = "";
            CHAR_DATA.forEach(c => {
                if(saveData.chars.includes(c.id)) {
                    let isAwakened = saveData.awakenedChars.includes(c.id);
                    let div = document.createElement('div');
                    div.className = `char-box ${isAwakened ? 'owned' : ''}`;
                    div.innerHTML = `<strong>${c.name}</strong><br>${isAwakened ? '<span style="color:#f0f; font-weight:bold;">★覚醒済み★</span>' : '未覚醒'}`;
                    div.onclick = () => { 
                        if(confirm(`${c.name}の覚醒ボスに挑みますか？`)){
                            startRaid(c.id);
                        }
                    };
                    list.appendChild(div);
                }
            });
            document.getElementById('screen-raid').classList.remove('hidden');
        };
        document.getElementById('btn-close-raid').onclick = openHome;

        // ガチャ画面
        document.getElementById('btn-gacha-menu').onclick = () => {
            document.getElementById('screen-home').classList.add('hidden');
            document.getElementById('gacha-result').style.display = 'none';
            document.getElementById('screen-gacha').classList.remove('hidden');
        };
        document.getElementById('btn-close-gacha').onclick = openHome;
        document.getElementById('btn-pull-gacha').onclick = () => {
            if(saveData.coins < 1000) return alert("コインが足りません!");
            saveData.coins -= 1000;
            let roll = Math.random();
            let newCharId = 1;
            if(roll < 0.01) newCharId = 19;
            else newCharId = Math.floor(Math.random() * 18) + 1;

            let cInfo = CHAR_DATA[newCharId];
            let resDiv = document.getElementById('gacha-result');
            if(saveData.chars.includes(newCharId)) {
                resDiv.innerText = `${cInfo.name} (ダブり... 300C還元)`;
                resDiv.style.color = "gray";
                saveData.coins += 300;
            } else {
                resDiv.innerText = `NEW! ${cInfo.name} ゲット!!`;
                resDiv.style.color = "#00ffcc";
                saveData.chars.push(newCharId);
            }
            resDiv.style.display = 'block';
            saveGame();
            document.getElementById('disp-coins').innerText = saveData.coins;
        };

        // --- ゲーム進行 ---
        document.getElementById('btn-start').onclick = () => {
            isRaidMode = false;
            initGame();
        };

        function startRaid(targetCharId) {
            isRaidMode = true;
            raidTargetCharId = targetCharId;
            initGame();
        }

        function initGame() {
            currentStage = parseInt(document.getElementById('stage-select').value);
            let c = CHAR_DATA[saveData.selectedChar];
            let isAwakened = saveData.awakenedChars.includes(c.id);
            
            // 覚醒ステータスボーナスを適用
            player = {
                x: width/2, y: height/2, size: 15, 
                hp: c.hp * (isAwakened ? 2 : 1), 
                maxHp: c.hp * (isAwakened ? 2 : 1), 
                color: c.color,
                level: 1, exp: 0, maxExp: 3, cid: c.id,
                stats: { 
                    multi: c.multi + (isAwakened ? 1 : 0), 
                    power: c.atk * (isAwakened ? 1.5 : 1), 
                    speed: c.spd * (isAwakened ? 1.2 : 1), 
                    orbit: c.orb + (isAwakened ? 1 : 0), 
                    magnet: c.mag * (isAwakened ? 1.5 : 1) 
                }
            };
            
            let nameHtml = c.name + (isAwakened ? " <span style='color:#f0f; font-weight:bold;'>★</span>" : "");
            document.getElementById('ui-char-name').innerHTML = nameHtml;
            document.getElementById('ui-char-name').style.color = c.color;

            enemies = []; bullets = []; gems = []; orbits = []; damageTexts = []; hazards = [];
            scoreCoins = 0; playTime = 300; frameCount = 0;
            isBossActive = false; bossDefeated = false;
            
            targetPos = { x: player.x, y: player.y }; 
            state = 'PLAYING';
            
            document.querySelectorAll('.overlay').forEach(s => s.classList.add('hidden'));
            document.getElementById('ui-layer').classList.remove('hidden');
            document.getElementById('boss-notice').style.display = 'none';
            loop();
        }

        function triggerLevelUp() {
            state = 'LEVELUP';
            targetPos.x = player.x; targetPos.y = player.y;

            player.level++;
            player.exp -= player.maxExp;
            player.maxExp = Math.floor(3 + player.level * 1.5);
            
            if(player.cid === 15) player.hp = player.maxHp; 

            document.getElementById('ui-level').innerText = player.level;
            const container = document.getElementById('skill-container');
            container.innerHTML = '';
            [...skillPool].sort(() => 0.5 - Math.random()).slice(0, 3).forEach(s => {
                let div = document.createElement('div');
                div.className = 'skill-card';
                div.innerHTML = `<strong>${s.name}</strong><p>${s.desc}</p>`;
                div.onclick = () => {
                    if(s.id === 'multi') player.stats.multi++;
                    if(s.id === 'power') player.stats.power += 10;
                    if(s.id === 'orbit') player.stats.orbit++;
                    if(s.id === 'magnet') player.stats.magnet += 60;
                    if(s.id === 'speed') player.stats.speed += 0.5;
                    if(s.id === 'heal') player.hp = Math.min(player.maxHp, player.hp + player.maxHp*0.5);
                    state = 'PLAYING';
                    targetPos.x = player.x; targetPos.y = player.y;
                    document.getElementById('screen-levelup').classList.add('hidden');
                    loop();
                };
                container.appendChild(div);
            });
            document.getElementById('screen-levelup').classList.remove('hidden');
        }

        function spawnEnemy() {
            if (isBossActive) return;
            let x = Math.random() < 0.5 ? (Math.random()<.5 ? -30 : width+30) : Math.random()*width;
            let y = (x < 0 || x > width) ? Math.random()*height : (Math.random()<.5 ? -30 : height+30);
            
            let timeMult = (300 - playTime) / 60;
            let hp = 10 * (1 + timeMult*2) * (1 + currentStage*0.2);
            let spd = 1.2 + timeMult*0.5 + currentStage*0.05;
            
            if(currentStage % 5 === 0 && Math.random() < 0.2) { spd *= 2; hp /= 2; }

            enemies.push({ x, y, size: 12, hp: hp, maxHp: hp, speed: spd, isBoss: false });
        }

        function spawnBoss() {
            isBossActive = true;
            document.getElementById('boss-notice').style.display = 'block';
            
            enemies = []; hazards = [];
            
            if (isRaidMode) {
                document.getElementById('boss-notice').innerText = "WARNING: AWAKENED BOSS!!";
                document.getElementById('boss-notice').style.color = "#ff00ff";
                setTimeout(() => document.getElementById('boss-notice').style.display = 'none', 3000);
                
                let rc = CHAR_DATA[raidTargetCharId];
                // レイドボスの圧倒的耐久力 (文字通りの500だと一瞬で溶けるため50,000に設定)
                let hp = 50000 * (1 + currentStage * 0.2); 
                enemies.push({
                    x: width/2, y: -120, size: 80,
                    hp: hp, maxHp: hp, speed: rc.spd * 0.5 + 0.5, isBoss: true,
                    isRaidBoss: true, color: rc.color, name: rc.name, atk: rc.atk, multi: rc.multi
                });
            } else {
                document.getElementById('boss-notice').innerText = "WARNING: HUGE BOSS!!";
                document.getElementById('boss-notice').style.color = "red";
                setTimeout(() => document.getElementById('boss-notice').style.display = 'none', 3000);
                
                let hp = 5000 * (1 + currentStage * 0.5);
                enemies.push({
                    x: width/2, y: -120, size: 100,
                    hp: hp, maxHp: hp, speed: 0.8 + currentStage*0.02, isBoss: true,
                    bossType: currentStage % 3 
                });
            }
        }

        function applyGimmicks() {
            if(isBossActive) return;
            if(currentStage % 3 === 0 && frameCount % 180 === 0) {
                hazards.push({ x: Math.random()*width, y: Math.random()*height, size: 50, life: 300 });
            }
        }

        function update() {
            if(state !== 'PLAYING') return;
            frameCount++;

            if(frameCount % 60 === 0) {
                playTime--;
                scoreCoins += (player.cid === 14 ? 4 : 2);
                if(playTime <= 180 && !isBossActive && !bossDefeated) spawnBoss();
                if(playTime <= 0) end(true);
            }

            let dx = targetPos.x - player.x;
            let dy = targetPos.y - player.y;
            player.x += dx * 0.1 * (player.stats.speed/4);
            player.y += dy * 0.1 * (player.stats.speed/4);

            applyGimmicks();

            if(frameCount % 15 === 0 && enemies.length > 0) {
                let target = enemies[0];
                let minDist = Math.hypot(player.x-target.x, player.y-target.y);
                enemies.forEach(e => {
                    let d = Math.hypot(player.x-e.x, player.y-e.y);
                    if(d < minDist) { minDist = d; target = e; }
                });
                let angle = Math.atan2(target.y-player.y, target.x-player.x);
                for(let i=0; i<player.stats.multi; i++){
                    let a = angle + (i - (player.stats.multi-1)/2) * 0.2;
                    bullets.push({x: player.x, y: player.y, vx: Math.cos(a)*12, vy: Math.sin(a)*12, life: 50, dmg: player.stats.power, isEnemy: false});
                }
            }

            if(!isBossActive) {
                let spawnRate = Math.max(2, 25 - Math.floor((300-playTime)/6));
                if(frameCount % spawnRate === 0) spawnEnemy();
            }

            orbits = [];
            for(let i=0; i<player.stats.orbit; i++) {
                let a = (frameCount * 0.1) + (i * Math.PI*2 / player.stats.orbit);
                orbits.push({x: player.x + Math.cos(a)*80, y: player.y + Math.sin(a)*80, size: 10});
            }

            for(let i=bullets.length-1; i>=0; i--){
                let b = bullets[i];
                b.x += b.vx; b.y += b.vy; b.life--;
                
                if(b.isEnemy && Math.hypot(player.x-b.x, player.y-b.y) < player.size + (b.size||5)) {
                    player.hp -= b.dmg;
                    bullets.splice(i, 1);
                    if(player.hp <= 0) end(false);
                    continue;
                }
                if(b.life <= 0) bullets.splice(i, 1);
            }

            for(let ei = enemies.length-1; ei>=0; ei--) {
                let e = enemies[ei];
                let angle = Math.atan2(player.y-e.y, player.x-e.x);
                e.x += Math.cos(angle) * e.speed;
                e.y += Math.sin(angle) * e.speed;

                if(e.isBoss && frameCount % 60 === 0) {
                    if (e.isRaidBoss) {
                        // 覚醒ボス専用の攻撃(キャラクターのマルチショットを模倣)
                        let shots = e.multi + 2; 
                        for(let i=0; i<shots; i++){
                            let a = angle + (i - (shots-1)/2) * 0.25;
                            bullets.push({x: e.x, y: e.y, vx: Math.cos(a)*6, vy: Math.sin(a)*6, life: 100, dmg: 10, isEnemy: true, size: 10});
                        }
                    } else {
                        if(e.bossType === 1) {
                            for(let i=0; i<8; i++){
                                let a = (Math.PI*2/8) * i;
                                bullets.push({x: e.x, y: e.y, vx: Math.cos(a)*5, vy: Math.sin(a)*5, life: 100, dmg: 15, isEnemy: true, size: 8});
                            }
                        } else if(e.bossType === 2 && frameCount % 180 === 0) {
                            e.speed = 8;
                            setTimeout(()=> { if(e) e.speed = 0.8 + currentStage*0.02; }, 500);
                        }
                    }
                }

                for(let bi=bullets.length-1; bi>=0; bi--) {
                    let b = bullets[bi];
                    if(!b.isEnemy && Math.hypot(e.x-b.x, e.y-b.y) < e.size + 5) {
                        e.hp -= b.dmg;
                        damageTexts.push({x: e.x, y: e.y, text: Math.floor(b.dmg), life: 20});
                        bullets.splice(bi, 1);
                    }
                }

                orbits.forEach(o => {
                    if(Math.hypot(e.x-o.x, e.y-o.y) < e.size + o.size && frameCount % 10 === 0) {
                        e.hp -= player.stats.power;
                        damageTexts.push({x: e.x, y: e.y, text: Math.floor(player.stats.power), life: 20});
                    }
                });

                if(e.hp <= 0) {
                    if(e.isBoss) { 
                        isBossActive = false; bossDefeated = true; 
                        scoreCoins += 1000; playTime = Math.min(playTime, 30); 
                    }
                    if(player.cid === 7 && Math.random()<0.1) player.hp = Math.min(player.maxHp, player.hp+1);
                    gems.push({x: e.x, y: e.y, val: e.isBoss ? 100 : 1});
                    enemies.splice(ei, 1);
                    scoreCoins += (e.isBoss ? 500 : 5);
                } else if(Math.hypot(player.x-e.x, player.y-e.y) < player.size + e.size) {
                    player.hp -= (e.isBoss ? 2 : 0.5);
                    if(player.hp <= 0) end(false);
                }
            }

            for(let i=hazards.length-1; i>=0; i--) {
                let h = hazards[i];
                h.life--;
                if(Math.hypot(player.x-h.x, player.y-h.y) < player.size + h.size && frameCount % 10===0) {
                    player.hp -= 2;
                    if(player.hp <= 0) end(false);
                }
                if(h.life <= 0) hazards.splice(i, 1);
            }

            for(let gi=gems.length-1; gi>=0; gi--) {
                let g = gems[gi];
                let d = Math.hypot(player.x-g.x, player.y-g.y);
                if(d < player.stats.magnet) {
                    let a = Math.atan2(player.y-g.y, player.x-g.x);
                    g.x += Math.cos(a)*15; g.y += Math.sin(a)*15;
                }
                if(d < 20) {
                    player.exp += g.val; gems.splice(gi, 1);
                    if(player.exp >= player.maxExp) triggerLevelUp();
                }
            }

            damageTexts.forEach((d, i) => { d.y--; d.life--; if(d.life <= 0) damageTexts.splice(i, 1); });

            let m = Math.floor(playTime/60), s = playTime%60;
            document.getElementById('timer').innerText = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
            document.getElementById('exp-bar').style.width = (player.exp/player.maxExp*100) + "%";
        }

        function draw() {
            if(currentStage % 4 === 0 && !isBossActive) {
                ctx.fillStyle = "rgba(0, 0, 0, 0.9)";
            } else {
                ctx.fillStyle = "rgba(5, 5, 15, 0.4)";
            }
            ctx.fillRect(0, 0, width, height);

            hazards.forEach(h => {
                ctx.fillStyle = `rgba(100, 0, 100, ${h.life/300 * 0.5})`;
                ctx.beginPath(); ctx.arc(h.x, h.y, h.size, 0, Math.PI*2); ctx.fill();
            });

            gems.forEach(g => { ctx.fillStyle = "#0f8"; ctx.beginPath(); ctx.arc(g.x, g.y, 4, 0, Math.PI*2); ctx.fill(); });
            
            bullets.forEach(b => { 
                ctx.fillStyle = b.isEnemy ? "#f0f" : "#ff0"; 
                let size = b.size || 5;
                ctx.beginPath(); ctx.arc(b.x, b.y, size, 0, Math.PI*2); ctx.fill(); 
            });
            
            orbits.forEach(o => { ctx.fillStyle = "#0ff"; ctx.beginPath(); ctx.arc(o.x, o.y, o.size, 0, Math.PI*2); ctx.fill(); });
            
            enemies.forEach(e => {
                if(e.isRaidBoss) {
                    // 覚醒ボス描画 (キャラクターと同じ見た目の丸形)
                    ctx.fillStyle = e.color; 
                    ctx.beginPath(); ctx.arc(e.x, e.y, e.size, 0, Math.PI*2); ctx.fill();
                    ctx.strokeStyle = "white"; ctx.lineWidth = 4; ctx.stroke();
                    ctx.fillStyle = "red"; ctx.fillRect(e.x-e.size, e.y-e.size-15, e.size*2*(e.hp/e.maxHp), 8);
                    ctx.fillStyle = "#ff00ff"; ctx.font = "bold 24px sans-serif"; ctx.textAlign = "center";
                    ctx.fillText("覚醒 " + e.name, e.x, e.y+e.size+30);
                } else {
                    // 通常敵
                    ctx.fillStyle = e.isBoss ? "#800" : "#f44";
                    ctx.fillRect(e.x-e.size, e.y-e.size, e.size*2, e.size*2);
                    ctx.fillStyle = "red"; ctx.fillRect(e.x-e.size, e.y-e.size-10, e.size*2*(e.hp/e.maxHp), 6);
                    if(e.isBoss) {
                        ctx.fillStyle = "white"; ctx.font = "20px sans-serif"; ctx.textAlign = "center";
                        ctx.fillText("BOSS", e.x, e.y+e.size+20);
                    }
                }
            });

            // プレイヤー
            ctx.fillStyle = player.color; ctx.beginPath(); ctx.arc(player.x, player.y, player.size, 0, Math.PI*2); ctx.fill();
            ctx.strokeStyle = "white"; ctx.lineWidth = 2; ctx.stroke();
            
            ctx.fillStyle = "#f00"; ctx.fillRect(player.x-25, player.y+22, 50, 6);
            ctx.fillStyle = "#0f0"; ctx.fillRect(player.x-25, player.y+22, 50*(player.hp/player.maxHp), 6);

            ctx.fillStyle = "white"; ctx.textAlign = "center"; ctx.font = "bold 16px sans-serif";
            damageTexts.forEach(d => { ctx.globalAlpha = d.life/20; ctx.fillText(d.text, d.x, d.y); });
            ctx.globalAlpha = 1;
        }

        function end(win) {
            state = 'RESULT';
            document.getElementById('ui-layer').classList.add('hidden');
            document.getElementById('screen-result').classList.remove('hidden');
            
            let titleEl = document.getElementById('res-title');
            titleEl.innerText = win ? "STAGE CLEAR!!" : "GAME OVER";
            titleEl.style.color = win ? "#0f0" : "#f00";
            
            if(win) {
                scoreCoins += 500;
                if(isRaidMode) {
                    scoreCoins += 2000; // レイドはクリアボーナス増量
                    if(!saveData.awakenedChars.includes(raidTargetCharId)) {
                        saveData.awakenedChars.push(raidTargetCharId);
                        titleEl.innerText = "AWAKENING SUCCESS!!";
                        titleEl.style.color = "#ff00ff";
                    }
                } else {
                    if(saveData.unlockedStage === currentStage && currentStage < 30) {
                        saveData.unlockedStage++;
                    }
                }
            }
            saveData.coins += scoreCoins;
            saveGame();
            document.getElementById('res-coins').innerText = scoreCoins;
        }

        function loop() { 
            if(state === 'PLAYING') { 
                update(); draw(); requestAnimationFrame(loop); 
            } 
        }

        window.addEventListener('mousemove', e => { 
            if(state === 'PLAYING') { targetPos.x = e.clientX; targetPos.y = e.clientY; }
        });
        window.addEventListener('touchmove', e => { 
            if(state === 'PLAYING') { targetPos.x = e.touches[0].clientX; targetPos.y = e.touches[0].clientY; }
        });

        document.getElementById('btn-restart').onclick = openHome;

        // 初期化実行
        loadData();

    </script>
</body>
</html>
